    await interaction.response.send_message(
        "📢 **ANNUNCIO RP**\n"
        "Scrivi il testo dell'annuncio e indica il personaggio che lo pubblica.",
        ephemeral=True
    )


@bot.event
async def on_ready():
    await tree.sync()
    print(f"Bot online: {bot.user}")


if not TOKEN:
    raise RuntimeError("Manca la variabile DISCORD_TOKEN")

bot.run(TOKEN)
